PORT=8787
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
LEAGUE_ID=league-v4.near-post.testnet
# The account that creates players' accounts, funds gas and plays match days.
PARENT_ACCOUNT_ID=near-post.testnet
# Secret. Never commit it.
PARENT_PRIVATE_KEY=
ACCOUNT_FUNDING_NEAR=0.3
TOPUP_BELOW_NEAR=0.15
TOPUPS_PER_DAY=2
# console prints codes in the log; resend sends them by email.
EMAIL_MODE=console
RESEND_API_KEY=
EMAIL_FROM=NEAR Post <play@near-post.dev>
PLAY_MATCH_DAYS=true
# Local tests only: returns the code in the response.
INSECURE_DEV_RETURN_CODE=false
# Demo crowd (scripts/seed-demo.mjs). The key is a secret.
CROWD=
CROWD_PRIVATE_KEY=
CROWD_EVERY=3
# Contracts whose storage balance the parent tops up.
KEEP_FUNDED=
# Signs training drill scores; its public key is set in the league at init. Secret.
ATTESTER_PRIVATE_KEY=
